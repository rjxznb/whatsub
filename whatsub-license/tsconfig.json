{
  // Base tsconfig — used by `pnpm typecheck` and IDEs. Includes BOTH src/
  // and tests/ so editor + tsc --noEmit cover everything.
  // For ACTUAL builds (emit JS), use tsconfig.build.json which narrows the
  // include to src/ only and restores rootDir, so dist/index.js lands at
  // the path package.json's "main" expects.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["dist", "node_modules"]
}
